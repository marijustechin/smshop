generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Authentication provider attached to a User.
enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

/// Account role. `USER` is the default for every account. `EDITOR` is reserved
/// for future editorial capabilities and deliberately carries no administration
/// / user-management access. `ADMIN` owns the first administration area.
enum Role {
  USER
  EDITOR
  ADMIN
}

/// Authentication identity. Deliberately NOT the e-commerce Customer aggregate:
/// no addresses, company data, order history, loyalty, or commerce preferences.
model User {
  id              String    @id @default(uuid(7))
  email           String
  emailNormalized String    @unique
  emailVerifiedAt DateTime?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts                AuthAccount[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

/// A single login method attached to a User. One identity may have multiple
/// providers (e.g. CREDENTIALS + GOOGLE). `providerAccountId` is the provider's
/// stable subject identifier (for Google: the OIDC `sub`, not the email).
model AuthAccount {
  id                String       @id @default(uuid(7))
  userId            String
  provider          AuthProvider
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One provider account can belong to only one user.
  @@unique([provider, providerAccountId])
  // A user has at most one account per provider (one credentials, one Google).
  @@unique([userId, provider])
  @@map("auth_accounts")
}

/// Server-side session/refresh record. Only a hash of the refresh token is
/// stored. Supports expiration, revocation, and user-wide invalidation.
model AuthSession {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// Single-use, expiring email verification token. Stores only a token hash.
model EmailVerificationToken {
  id         String    @id @default(uuid(7))
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Single-use, expiring password reset token. Stores only a token hash.
/// Kept separate from email verification tokens so the two purposes are never
/// interchangeable.
model PasswordResetToken {
  id         String    @id @default(uuid(7))
  userId     String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Public product area. A category belongs to exactly one scope, and a product
/// row may only reference a category whose scope matches its own table.
enum ProductScope {
  CATALOG
  SHOP
}

/// Publication state shared by catalogue and e-shop products.
enum ProductStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// Category scoped to exactly one public area. Catalogue (CATALOG) and e-shop
/// (SHOP) categories are never interchangeable; slugs are unique within a scope.
/// `parentId` allows at least one nesting level (self-relation, delete restricted).
model Category {
  id           String       @id @default(uuid(7))
  scope        ProductScope
  name         String
  slug         String
  parentId     String?
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parent          Category?        @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryHierarchy")
  catalogProducts CatalogProduct[]
  shopProducts    ShopProduct[]

  @@unique([scope, slug])
  @@index([scope])
  @@index([parentId])
  @@map("categories")
}

/// Informational catalogue item (cakes, confectionery, made-to-order). Never
/// purchasable: deliberately no price, discount, stock, SKU, variants, cart,
/// checkout or shipping fields. `rating*` fields are verified legacy imports
/// (read-only, never employee-edited).
model CatalogProduct {
  id               String        @id @default(uuid(7))
  categoryId       String
  name             String
  slug             String        @unique
  description      String
  primaryImageUrl  String
  galleryImageUrls String[]      @default([])
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)
  // Verified legacy rating imported from the old public product page. Decimal,
  // never a floating-point approximation; exposed publicly only when both a
  // positive score and a positive count exist.
  ratingAverage    Decimal?      @db.Decimal(2, 1)
  ratingCount      Int?
  ratingSourceUrl  String?
  ratingImportedAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags     CatalogTag[]

  @@index([categoryId])
  @@index([status])
  @@map("catalog_products")
}

/// Reusable catalogue tag. The visual `#` is presentation only and is never
/// stored.
model CatalogTag {
  id        String           @id @default(uuid(7))
  name      String
  slug      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  CatalogProduct[]

  @@map("catalog_tags")
}

/// Online-purchasable e-shop product. Monetary values are integer cents only
/// (never floating point). Public visibility additionally requires
/// `status = PUBLISHED` AND `stockQuantity > 0` (see the shop public-eligibility
/// policy); out-of-stock products stay visible in admin only.
model ShopProduct {
  id               String        @id @default(uuid(7))
  categoryId       String
  name             String
  slug             String        @unique
  shortDescription String
  description      String
  primaryImageUrl  String
  galleryImageUrls String[]      @default([])
  sku              String?       @unique
  priceCents       Int
  salePriceCents   Int?
  saleStartsAt     DateTime?
  saleEndsAt       DateTime?
  stockQuantity    Int           @default(0)
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([status])
  @@index([stockQuantity])
  @@map("shop_products")
}

/// Physical-store operating state (SITE-003). `HIDDEN` stores are never returned
/// by the public contacts endpoint; a `TEMPORARILY_CLOSED` store is shown with an
/// explicit closure notice instead of its normal hours.
enum StoreStatus {
  OPERATING
  TEMPORARILY_CLOSED
  HIDDEN
}

/// A city that groups physical stores. `nameNormalized` (trimmed, lower-cased) is
/// unique so duplicate city names cannot be created; a city with stores cannot be
/// deleted (reverse relation is `onDelete: Restrict`).
model City {
  id             String   @id @default(uuid(7))
  name           String
  nameNormalized String   @unique
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stores Store[]

  @@index([displayOrder])
  @@map("cities")
}

/// A physical store with an optional notice and a weekly schedule. Email/notice
/// are optional; the address is required. Domain is independent of catalogue and
/// e-shop categories.
model Store {
  id           String      @id @default(uuid(7))
  name         String
  cityId       String
  address      String
  phone        String?
  email        String?
  status       StoreStatus @default(OPERATING)
  notice       String?
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  city  City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  hours StoreHours[]

  @@index([cityId])
  @@index([status])
  @@map("stores")
}

/// One weekday row per store. `weekday` is ISO-8601 (1 = Monday … 7 = Sunday).
/// This version supports a single opening interval per day; a `closed` day has no
/// times. See docs (SITE-003) for that limitation.
model StoreHours {
  id      String  @id @default(uuid(7))
  storeId String
  weekday Int
  closed  Boolean @default(false)
  opens   String?
  closes  String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
  @@map("store_hours")
}

/// Fixed business contact group (administration, orders, online shop). `key` is a
/// stable identifier; the group's email is the future contact-form topic
/// recipient. Working hours stay free text because the source does not specify
/// weekdays.
model ContactGroup {
  id           String   @id @default(uuid(7))
  key          String   @unique
  title        String
  phone        String
  email        String
  hours        String
  address      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contact_groups")
}
