    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
