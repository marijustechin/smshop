# API local development configuration.
# Copy to apps/api/.env (gitignored). Never commit real secrets.
# Validation runs at startup; required variables fail fast if missing/invalid.
# Any secret below can alternatively be provided via <NAME>_FILE pointing to a
# file containing the value (container/Docker secrets friendly).

# --- Required now ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://smshop:smshop@localhost:5432/smshop
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-secret
JWT_ACCESS_TTL=15m

# --- Refresh session (opaque refresh token; no refresh secret) ---
AUTH_SESSION_TTL=7d

# --- Optional ---
# API_ORIGIN=http://localhost:3001

# --- Email (SMTP). All-or-none: set the whole block or none of it. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true            # "true" for implicit TLS (e.g. 465), else "false"
# SMTP_USER=smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_PASSWORD_FILE=/run/secrets/smtp-password   # alternative to SMTP_PASSWORD
# MAIL_FROM="Sender Name <noreply@example.com>"

# --- Google OAuth (all-or-none: set the whole block to enable Google login) ---
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google-client-secret   # alternative
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# The callback URL must match the Authorized redirect URI registered in Google Cloud.

# --- Cloudflare Turnstile (backend secret). When unset, Turnstile is disabled
# (local dev / CI need no secret). When set, register/login/forgot-password/
# resend-verification require a valid challenge and fail closed. ---
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
# TURNSTILE_SECRET_KEY_FILE=/run/secrets/turnstile-secret   # alternative
