# API local development configuration.
# Copy to apps/api/.env (gitignored). Never commit real secrets.
# This is the required source for `pnpm dev`: the API validates its environment
# at startup and exits if a required value is missing. `pnpm dev` runs a
# preflight (scripts/check-dev-env.mjs) that reports missing names before either
# server starts.
# Validation runs at startup; required variables fail fast if missing/invalid.
# Any secret below can alternatively be provided via <NAME>_FILE pointing to a
# file containing the value (container/Docker secrets friendly).

# --- Required now ---
NODE_ENV=development
# Local API port. Production/container port remains 3001 (set by Compose).
PORT=3100
# Matches the local PostgreSQL Compose service (`pnpm db:up`).
DATABASE_URL=postgresql://smshop:smshop@localhost:5432/smshop
# Browser origin of the Next.js dev server (CORS + email links). Must be
# http://localhost:3101 for `pnpm dev`.
WEB_ORIGIN=http://localhost:3101
# Local-only secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Never reuse a production value or commit this file.
JWT_ACCESS_SECRET=replace-with-a-32-plus-character-secret
JWT_ACCESS_TTL=15m

# --- Database (alternative to DATABASE_URL) ---
# The API can assemble DATABASE_URL in process from these components plus the
# password. This matches the infrastructure secret-file model: the password is
# mounted as a file and never rendered into a nonsecret env value. An explicit
# DATABASE_URL (or DATABASE_URL_FILE) always wins over the components.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smshop
# DB_USER=smshop
# DB_PASSWORD=replace-with-db-password
# DB_PASSWORD_FILE=/run/secrets/db_app_password   # alternative to DB_PASSWORD

# --- Refresh session (opaque refresh token; no refresh secret) ---
AUTH_SESSION_TTL=7d

# --- Optional ---
# API_ORIGIN=http://localhost:3100

# --- Email (SMTP). All-or-none: set the whole block or none of it. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true            # "true" for implicit TLS (e.g. 465), else "false"
# SMTP_USER=smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_PASSWORD_FILE=/run/secrets/smtp-password   # alternative to SMTP_PASSWORD
# MAIL_FROM="Sender Name <noreply@example.com>"

# --- Google OAuth (all-or-none: set the whole block to enable Google login) ---
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google-client-secret   # alternative
# GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback
# The callback URL must match the Authorized redirect URI registered in Google Cloud.

# --- Cloudflare Turnstile (backend secret) ---
# Local development uses Cloudflare's official ALWAYS-PASS TEST secret so the
# full challenge path works on localhost without real challenges. These test
# credentials are PUBLIC and TEST-ONLY: never use them in staging or production.
# There, supply the real secret via TURNSTILE_SECRET_KEY(_FILE).
# Reference: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# When unset, Turnstile is disabled (CI needs no secret). When set, register/
# login/forgot-password/resend-verification require a valid challenge and fail
# closed. The test secret always passes; production secrets reject invalid
# tokens. Local sitekey counterpart lives in apps/web/.env.local.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SECRET_KEY_FILE=/run/secrets/turnstile-secret   # real secret in staging/production
