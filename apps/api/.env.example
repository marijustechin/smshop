# API local development configuration.
# Copy to apps/api/.env (gitignored). Never commit real secrets.
# Validation runs at startup; required variables fail fast if missing/invalid.
# Any secret below can alternatively be provided via <NAME>_FILE pointing to a
# file containing the value (container/Docker secrets friendly).

# --- Required now ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://smshop:smshop@localhost:5432/smshop

# --- Reserved for Auth v1 (optional until their feature lands) ---
# WEB_ORIGIN=http://localhost:3000
# API_ORIGIN=http://localhost:3001
# JWT_ACCESS_SECRET=replace-with-a-32-plus-character-secret
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
# JWT_REFRESH_TTL=30d

# --- Email (SMTP). All-or-none: set the whole block or none of it. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true            # "true" for implicit TLS (e.g. 465), else "false"
# SMTP_USER=smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_PASSWORD_FILE=/run/secrets/smtp-password   # alternative to SMTP_PASSWORD
# MAIL_FROM="Sender Name <noreply@example.com>"

# --- Google OAuth (reserved for Auth v1) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
