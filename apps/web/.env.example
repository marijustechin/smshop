# Frontend local development configuration (copy to apps/web/.env.local).
# Only public (NEXT_PUBLIC_*) values belong here. Never put backend secrets here.

# API origin used by the browser. In development the frontend (3101) and API
# (3100) are separate, so this must point at the API origin. In production the
# API is same-origin under /api and this can be left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100

# Cloudflare Turnstile site key (public by design). Local development uses
# Cloudflare's official ALWAYS-PASS TEST sitekey so the widget renders on
# localhost. TEST-ONLY: staging/production use the real sitekey (inlined at
# image build time). When unset, the widget is not rendered. The matching test
# secret lives in apps/api/.env.
# Reference: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
