# Frontend local development configuration (copy to apps/web/.env.local).
# Only public (NEXT_PUBLIC_*) values belong here. Never put backend secrets here.

# API origin used by the browser. In development the frontend (3000) and API
# (3001) are separate, so this must point at the API origin. In production the
# API is same-origin under /api and this can be left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
