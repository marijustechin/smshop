# Local development configuration (copy to .env as needed).

# PostgreSQL (development Compose)
POSTGRES_USER=smshop
POSTGRES_PASSWORD=smshop
POSTGRES_DB=smshop
POSTGRES_PORT=5432

# Application database connection (development)
DATABASE_URL=postgresql://smshop:smshop@localhost:5432/smshop

# Isolated database used by database-backed tests (`pnpm test:db`).
# The name must end with `_test`; the scripts refuse any other target.
TEST_DATABASE_URL=postgresql://smshop_test:smshop_test@localhost:5433/smshop_test

# Test database Compose service (profile `test`; started by `pnpm db:test:up`)
TEST_POSTGRES_USER=smshop_test
TEST_POSTGRES_PASSWORD=smshop_test
TEST_POSTGRES_DB=smshop_test
TEST_POSTGRES_PORT=5433
